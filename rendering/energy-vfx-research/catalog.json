  "layers": [
    {
      "id": "body",
      "name": "能量主体 / 体积",
      "tech": "局部三维密度场＋发射/吸收积分",
      "sources": [
        "clouds",
        "psrd",
        "veil",
        "fluid3"
      ],
      "learn": "把密度、发射强度和外形分开。用球/环/柱域裁剪，对视线积分；观察内部遮挡与相机移动时的视差。",
      "accept": "关闭 Bloom 后仍有内部层次；侧视和近距离观察没有明显纸片感；进入体积与被方块遮挡时成立。"
    },
    {
      "id": "flow",
      "name": "内部流动 / 卷吸",
      "tech": "Flow noise、势函数旋度、平流、涡量约束",
      "sources": [
        "psrd",
        "curl",
        "swarm",
        "fluid2",
        "fluid3"
      ],
      "learn": "区分梯度旋转的程序化形变、速度场积分与状态网格输运。粗尺度控制翻滚，细尺度塑造拉伸与扰动。",
      "accept": "低亮度慢放仍可追踪结构连续运动；不是纹理整体滑动或逐帧随机闪烁。"
    },
    {
      "id": "edge",
      "name": "边缘扰动 / 撕裂",
      "tech": "域扭曲、Worley 侵蚀、阈值与薄层消散",
      "sources": [
        "clouds",
        "noise",
        "psrd",
        "wig",
        "noiseball"
      ],
      "learn": "先定义稳定的大形状，再让较小尺度密度削去边缘；用连续阈值和生命周期生成缺口与细碎须。",
      "accept": "外围持续形成与消失局部孔洞；轮廓保持可读，不出现规则硬球边缘。"
    },
    {
      "id": "filament",
      "name": "能量丝 / 连续带",
      "tech": "三维轨迹、吸引子、历史点、网格带或细管",
      "sources": [
        "swarm",
        "curl",
        "wig",
        "effekseer",
        "photon"
      ],
      "learn": "在三维位置场中积分路径；宽度、亮度和寿命沿路径变化；按视角选择稳定网格带或管状截面。",
      "accept": "能围绕核心、聚拢和分叉；绕相机观察没有全程同一平面；细丝只负责局部强调。"
    },
    {
      "id": "smoke",
      "name": "烟雾 / 气态层",
      "tech": "密度输运、形状细节分层、局部三维流体",
      "sources": [
        "fluid3",
        "clouds",
        "noise",
        "fluid2"
      ],
      "learn": "体积密度表达稀薄外晕；平流产生物质连续性；大涡与高频侵蚀分离。",
      "accept": "外层较慢且稀薄，内部更紧凑；避免无方向白噪声和均匀发亮的棉花团。"
    },
    {
      "id": "shock",
      "name": "冲击波 / 能量环",
      "tech": "环带网格、薄球壳、半径和厚度寿命曲线",
      "sources": [
        "effekseer",
        "psrd"
      ],
      "learn": "环几何与生命周期控制传播；噪声破坏边缘，扩张时减薄与衰减；决定它是地面环还是三维波面。",
      "accept": "波面从核心向外传播且寿命有限；爆发起点、最大半径、厚度与消散可独立控制。"
    },
    {
      "id": "distortion",
      "name": "背景 / 屏幕扭曲",
      "tech": "独立世界颜色副本＋有界偏移＋深度遮挡",
      "sources": [
        "effekseer",
        "veil",
        "fluid2"
      ],
      "learn": "UV 域扭曲只是场函数变形；世界扭曲必须采样已渲染场景。复制背景，输出局部偏移与权重，约束前景串色。",
      "accept": "有纹理背景确实被偏移；前景方块没有被背景错误覆盖；读取目标不与写入目标相同。"
    },
    {
      "id": "bloom",
      "name": "自发光 / 外扩辉光",
      "tech": "线性发射、对象发光通道、模糊金字塔、色调映射",
      "sources": [
        "shimmer",
        "bloom"
      ],
      "learn": "核心局部亮区与外围衰减；单独 emission 缓冲负责选择性 Bloom。发光、散射和地形照明是不同问题。",
      "accept": "关掉 Bloom 主体仍成立；开后亮点柔和扩散但不抹去细丝和内部明暗。"
    },
    {
      "id": "choreography",
      "name": "蓄力 / 爆发 / 消散",
      "tech": "生命周期状态机＋参数曲线＋层间错峰",
      "sources": [
        "effekseer",
        "photon",
        "lodestone"
      ],
      "learn": "统一 seed、age、phase；半径、吸引力、噪声频率、发射、丝线长度和冲击波各有曲线，禁止只改整体缩放。",
      "accept": "蓄力吸入、瞬间释放、传播和尾部消散可辨识；暂停、回放和不同帧率下结果可解释。"
    },
    {
      "id": "aux",
      "name": "火星 / 碎屑辅助",
      "tech": "少量轨迹粒子、局部速度场、统一容量",
      "sources": [
